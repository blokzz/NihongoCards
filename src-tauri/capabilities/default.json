{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Domyślne uprawnienia okna głównego.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "https://*/*" }
      ]
    }
  ]
}
